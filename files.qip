# Dooyong core file list, sourced by Arcade-Dooyong.qsf. Paths relative to
# the project directory. Only real .qip files (QIP_FILE) may use
# $::quartus(qip_path).

# core RTL
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_layer_pass.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_spr_z80.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_snd.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_sys.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dy_board.sv

# T80 (VHDL for synthesis; T80s.v is the Verilator translation, not used here)
set_global_assignment -name VHDL_FILE rtl/vendor/t80/T80_Reg.vhd
set_global_assignment -name VHDL_FILE rtl/vendor/t80/T80_MCode.vhd
set_global_assignment -name VHDL_FILE rtl/vendor/t80/T80_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/vendor/t80/T80.vhd
set_global_assignment -name VHDL_FILE rtl/vendor/t80/T80s.vhd

# jt51 (YM2151) via its own qip
set_global_assignment -name QIP_FILE rtl/vendor/jt51/hdl/jt51.qip

# jt6295 (OKI M6295), INTERPOL=0, listed explicitly as in Hyper Duel
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_adpcm.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_timing.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_acc.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_rom.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_serial.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt6295/hdl/jt6295_sh_rst.v
set_global_assignment -name SEARCH_PATH rtl/vendor/jt6295/hdl

# fx68k (cycle-exact 68000); microrom/nanorom .mem found via SEARCH_PATH
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/fx68k/fx68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vendor/fx68k/uaddrPla.sv
set_global_assignment -name SEARCH_PATH rtl/vendor/fx68k

# jt03 (YM2203) + jt49 (its SSG), from jotego/jt12 (rtl/vendor/jt03/PROVENANCE.md)
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt03.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt03_acc.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_csr.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_div.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_dout.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg_cnt.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg_comb.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg_final.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg_pure.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_eg_step.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_exprom.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_kon.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_lfo.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_logsin.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_mmr.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_mod.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_op.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_pg.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_pg_comb.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_pg_dt.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_pg_inc.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_pg_sum.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_pm.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_reg.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_reg_ch.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_sh.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_sh24.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_sh_rst.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_single_acc.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_sumch.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_timers.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt12_top.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49_bus.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49_cen.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49_div.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49_eg.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49_exp.v
set_global_assignment -name VERILOG_FILE rtl/vendor/jt03/hdl/jt49_noise.v
set_global_assignment -name SEARCH_PATH rtl/vendor/jt03/hdl

# core PLL: 96 MHz system + 96 MHz -90 degrees for SDRAM_CLK
set_global_assignment -name VERILOG_FILE pll.v
set_global_assignment -name VERILOG_FILE pll/pll_0002.v

# shell
set_global_assignment -name SDC_FILE Arcade-Dooyong.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-Dooyong.sv
