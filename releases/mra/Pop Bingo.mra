<misterromdescription>
    <name>Pop Bingo</name>
    <setname>popbingo</setname>
    <rbf>Dooyong</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Dooyong</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <switches default="FB,FF">
        <dip name="Service Mode" bits="0" ids="On,Off" />
        <dip name="Coin Type" bits="1" ids="B,A" />
        <dip name="Demo Sounds" bits="2" ids="On,Off" />
        <dip name="Flip Screen" bits="3" ids="On,Off" />
        <dip name="Coin A" bits="4,5" ids="2C/3C,2C/1C,1C/2C,1C/1C" />
        <dip name="Coin B" bits="6,7" ids="2C/3C,2C/1C,1C/2C,1C/1C" />
        <dip name="VS Max Round" bits="8" ids="1,3" />
        <dip name="Difficulty" bits="10,11" ids="Hardest,Hard,Easy,Normal" />
        <dip name="Blocks Don't Drop" bits="14" ids="On,Off" />
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,L" />
    <rom index="1">
        <part>09</part>
    </rom>
    <rom index="0" zip="popbingo.zip" md5="none">
        <interleave output="16">
            <part name="rom2.3f" crc="b24513c6" offset="0x0" length="0x20000" map="01" />
            <part name="rom3.3e" crc="48070081" offset="0x0" length="0x20000" map="10" />
        </interleave>
        <part name="rom1.3p" crc="46e8d2c4" offset="0x0" length="0x10000" />
        <part repeat="0x30000">00</part>
        <part name="rom4.4r" crc="0fdee034" offset="0x0" length="0x20000" />
        <part repeat="0xA0000">00</part>
        <interleave output="16">
            <part name="rom5.9m" crc="e8d73e07" offset="0x0" length="0x80000" map="01" />
            <part name="rom6.9l" crc="c3db3975" offset="0x0" length="0x80000" map="10" />
        </interleave>
        <part repeat="0x100000">00</part>
        <interleave output="16">
            <part name="rom10.9a" crc="135ab90a" offset="0x0" length="0x80000" map="01" />
            <part name="rom9.9c" crc="c9d90007" offset="0x0" length="0x80000" map="10" />
