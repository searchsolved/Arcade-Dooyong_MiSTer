        <dip name="Cabinet" bits="12" ids="Cocktail,Upright" />
        <dip name="Girl Show Point" bits="14" ids="Asia,Other Country" />
        <dip name="Allow Continue" bits="15" ids="No,Yes" />
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Service,Button 3" default="A,B,Start,Select,L,X" />
