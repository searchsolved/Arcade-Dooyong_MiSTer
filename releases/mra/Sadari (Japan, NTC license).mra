        <dip name="Coin B" bits="6,7" ids="2C/3C,2C/1C,1C/2C,1C/1C" />
        <dip name="Show Girl" bits="8,9" ids="Skip Skip Skip,Dress Half Naked,Dress Half Half,Dress Dress Dress" />
