        <dip name="Coin A" bits="4,5" ids="2C/3C,2C/1C,1C/2C,1C/1C" />
        <dip name="Coin B" bits="6,7" ids="2C/3C,2C/1C,1C/2C,1C/1C" />
        <dip name="Show Girl" bits="8,9" ids="Skip Skip Skip,Dress Half Naked,Dress Half Half,Dress Dress Dress" />
        <dip name="Difficulty" bits="10,11" ids="Hardest,Hard,Easy,Normal" />
        <dip name="Cabinet" bits="12" ids="Cocktail,Upright" />
        <dip name="Allow Continue" bits="15" ids="No,Yes" />
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,L" />
