    <year>1994</year>
    <manufacturer>Dooyong</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <switches default="FF,FD">
        <dip name="Service Mode" bits="0" ids="On,Off" />
        <dip name="Coin Type" bits="1" ids="B,A" />
