        <dip name="Cabinet" bits="12" ids="Cocktail,Upright" />
        <dip name="Allow Continue" bits="15" ids="No,Yes" />
    </switches>
    <buttons names="Button 1,Button 2,Start,Coin,Service" default="A,B,Start,Select,L" />
